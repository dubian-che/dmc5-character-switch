+    // Another subclass may wrap our window_proc. Replacing this object then
+    // loses its original-proc link and can make the combined chain circular.
+    bool is_valid_for(HWND wnd) const {
+        return wnd != nullptr && m_wnd == wnd && m_original_proc != nullptr;
+    }
